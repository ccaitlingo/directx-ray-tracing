# Simple plane.obj
# 4 vertices, 2 triangles

mtllib plane.mtl

# Vertex positions
v -5.0 0.0 -5.0
v  5.0 0.0 -5.0
v  5.0 0.0  5.0
v -5.0 0.0  5.0

# Texture coordinates (UV)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn 0.0 1.0 0.0

# Faces (using vertex/uv/normal)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1